# App
APP_ENV=development
APP_LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./cc98_watch.db
CORS_ORIGINS=*
ENABLE_PUBLIC_DOCS=true
ENABLE_SCHEDULER=false
SCAN_INTERVAL_MINUTES=10
SUBSCRIPTION_LIMIT=10
ADMIN_API_TOKEN=change-me-admin-token

# Product auth
JWT_SECRET=change-me-in-production
SESSION_EXPIRE_HOURS=168
EMAIL_CODE_EXPIRE_MINUTES=10
ZJU_EMAIL_DOMAINS=zju.edu.cn,intl.zju.edu.cn
AUTH_DEV_PRINT_CODE=true
AUTH_EMAIL_DELIVERY=true

# Email notification channel, e.g. NetEase 163/126 SMTP.
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TIMEOUT=10

# CC98 service account for Watch only
CC98_API_BASE_URL=https://api.cc98.org
CC98_OPENID_BASE_URL=https://openid.cc98.org
CC98_CLIENT_ID=9a1fd200-8687-44b1-4c20-08d50a96e5cd
CC98_CLIENT_SECRET=8b53f727-08e2-4509-8857-e34bf92b27f2
CC98_SERVICE_USERNAME=
CC98_SERVICE_PASSWORD=
CC98_SERVICE_REFRESH_TOKEN=
CC98_TIMEOUT=10
CC98_TRUST_ENV=false
CC98_SEARCH_MIN_INTERVAL_SECONDS=1.2
CC98_SEARCH_RETRY_ATTEMPTS=2
CC98_NEW_POSTS_MIN_INTERVAL_SECONDS=2
CC98_NEW_POSTS_RETRY_ATTEMPTS=2
NEW_POST_PAGE_SIZE=20
MAX_NEW_POST_PAGES=10
# Leave blank to establish a baseline from the current server list head.
# Set this only when restoring a known cursor from another deployment.
CC98_INITIAL_TOPIC_ID=
WATCH_INITIAL_CURSOR_MODE=baseline

# Matcher
AI_API_KEY=
AI_BASE_URL=https://api.siliconflow.cn/v1
AI_LLM_MODEL=Qwen/Qwen2.5-14B-Instruct
AI_LLM_PROVIDER=openai
MATCHER_FORCE_RULES=true
WATCH_FORCE_MOCK_TOPICS=false
MATCHER_BATCH_TOPIC_LIMIT=30
MATCHER_BATCH_SUBSCRIPTION_LIMIT=50

# Notifications
DINGTALK_TIMEOUT=10
NOTIFICATION_BATCH_SIZE=20
NOTIFICATION_DUE_GRACE_SECONDS=5
NOTIFICATION_READ_RATE_LIMIT_SECONDS=60
